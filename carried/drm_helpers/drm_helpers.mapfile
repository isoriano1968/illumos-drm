#
# The functions of misc/drm_helpers a module may use: link it with
#   ld -ztype=kmod -N misc/drm_helpers -z defs ... -M drm_helpers.mapfile
# They are the Linux symbols of the carried helpers that i915's headless
# build (Linux v7.2, the R5c configuration) imports: drm_mm's ten and
# drm_cache's drm_clflush_virt_range() and drm_clflush_sg(); and for
# amdgpu and TTM drm_mm_print(), drm_memcpy_from_wc() and drm_need_swiotlb()
# (drm_cache's other functions stay local; the module
# links against misc/linuxkpi for pages and scatterlists, R5c).
# drm_helpers_scope.mapfile, the module's own
# symbol-scope mapfile, lists the same names; CI compares the two lists
# and the module's global symbols.
#
$mapfile_version 2

SYMBOL_SCOPE {
	global:
		__drm_mm_interval_first		{ FLAGS = EXTERN };
		drm_mm_init			{ FLAGS = EXTERN };
		drm_mm_insert_node_in_range	{ FLAGS = EXTERN };
		drm_mm_remove_node		{ FLAGS = EXTERN };
		drm_mm_reserve_node		{ FLAGS = EXTERN };
		drm_mm_scan_add_block		{ FLAGS = EXTERN };
		drm_mm_scan_color_evict		{ FLAGS = EXTERN };
		drm_mm_scan_init_with_range	{ FLAGS = EXTERN };
		drm_mm_scan_remove_block	{ FLAGS = EXTERN };
		drm_mm_takedown			{ FLAGS = EXTERN };
		drm_clflush_virt_range		{ FLAGS = EXTERN };
		drm_clflush_sg			{ FLAGS = EXTERN };
		# amdgpu and TTM (drivers/amdgpu)
		drm_mm_print			{ FLAGS = EXTERN };
		drm_memcpy_from_wc		{ FLAGS = EXTERN };
		drm_need_swiotlb		{ FLAGS = EXTERN };
};
