#
# SPDX-License-Identifier: MIT
# Copyright 2026 The illumos-drm authors
#
# IPS manifest of misc/linuxkpi (usr/src/uts/common/io/linuxkpi/), the illumos Linux
# compatibility layer that Linux DRM drivers built for the illumos-drm
# facade (today i915n) and misc/drm_helpers link against with
# -N misc/linuxkpi. Publish from a directory holding the module built by
# usr/src/uts/common/io/linuxkpi/build.sh as kernel/misc/amd64/linuxkpi, with this repository as
# the second directory for the MIT notice (include/drm/LICENSE):
#
#   usr/src/uts/common/io/linuxkpi/build.sh all          # $OUT/linuxkpi
#   cp $OUT/linuxkpi <proto>/kernel/misc/amd64/linuxkpi
#   pkgsend publish -s <repo> -d <proto> -d . usr/src/pkg/manifests/linuxkpi.p5m
#
# The module is linked with -N misc/drm_core (fences, reservations, the
# DRM device of the drivers it serves), so it belongs to the illumos-drm
# stack: drmadm's exclusion of misc/drm_core under `drmadm select legacy`
# keeps it from loading with the legacy stack. It has no device nodes and
# no driver action; the kernel loads it with the first module that depends
# on it. The test driver linuxkpi_selftest is not packaged
# (usr/src/test/drm-tests/run-r5c-test.sh installs and removes it).
#
set name=pkg.fmri value=pkg://illumos-drm/driver/graphics/linuxkpi@0.0.2.1,5.11-2026.0.0.0
set name=pkg.summary value="Linux kernel interfaces for DRM drivers (misc/linuxkpi)"
set name=pkg.description value="misc/linuxkpi, the illumos LinuxKPI layer of illumos-drm: MIT-licensed implementations of the Linux kernel interfaces (memory, pages, DMA, locks, wait queues, RCU, timers, workqueues, PCI, interrupts, firmware) that Linux DRM drivers on the illumos-drm facade use, over the DDI."
set name=info.classification value=org.opensolaris.category.2008:Drivers/Display
set name=info.source-url value=https://code.aopc.cloud/illumos/illumos-drm
set name=variant.arch value=i386
set name=org.opensolaris.consolidation value=userland
dir  path=kernel owner=root group=sys mode=0755
dir  path=kernel/misc owner=root group=sys mode=0755
dir  path=kernel/misc/amd64 owner=root group=sys mode=0755
file path=kernel/misc/amd64/linuxkpi owner=root group=sys mode=0755 reboot-needed=true
depend fmri=pkg:/driver/graphics/drm-core@0.0.2.1 type=require
# Built against facade 2.1 of this version of the core.
depend fmri=pkg:/driver/graphics/drm-core@0.0.2.1 type=incorporate
license usr/src/uts/common/drm/LICENSE license=MIT
