#
# SPDX-License-Identifier: MIT
# Copyright 2026 The illumos-drm authors
#
# amdgpu, AMD's GPU driver of Linux v7.2 built for the illumos-drm DRM
# core (usr/src/uts/intel/io/amdgpu). Built with Display Core.
# It binds Polaris 11 (pciex1002,67ef: MacBook Pro 15-inch 2017), tested
# there with DC on DCE 11.2. Southern Islands tests (FirePro D500, Tahiti)
# still bind one device by its subsystem-specific compatible name
# (update_drv -a -i '"pci1002,679e.106b.126"' amdgpu).
# Built and published by the gate (dmake install; dmake package): the
# licence file LICENSE.amdgpu is written by
# usr/src/uts/intel/io/i915n/gen-license.sh (MODULE=amdgpu) from the
# module's linux-inputs.txt. The firmware is unmodified AMD microcode with
# its own licence (usr/src/data/firmware/README.md); it is not in Git, and
# usr/src/tools/build/stage.sh refuses to stage without it.
#
set name=pkg.fmri value=pkg://illumos-drm/driver/graphics/amdgpu@0.0.2.12,5.11-2026.0.0.0
set name=pkg.summary value="AMD GPU driver from Linux amdgpu (bring-up)"
set name=pkg.description value="amdgpu, the amdgpu driver of Linux v7.2 built for the illumos-drm DRM core and its Linux compatibility layer, with Display Core (DCE 11.2), for Polaris 11 (MacBook Pro 15-inch 2017, Radeon Pro 555/560, PCI 1002,67ef; tested) and bring-up tests on Southern Islands GPUs (Tahiti). Includes the Tahiti firmware; the Polaris firmware is system/firmware/amdgpu-polaris. Binds pciex1002,67ef only."
set name=info.classification value=org.opensolaris.category.2008:Drivers/Display
set name=info.source-url value=https://code.aopc.cloud/illumos/illumos-drm
set name=variant.arch value=i386
set name=org.opensolaris.consolidation value=userland
dir  path=kernel owner=root group=sys mode=0755
dir  path=kernel/drv owner=root group=sys mode=0755
dir  path=kernel/drv/amd64 owner=root group=sys mode=0755
file path=kernel/drv/amd64/amdgpu owner=root group=sys mode=0755 reboot-needed=true
# ddi-no-autodetach=1: nothing may open a GPU (a compute GPU never is), and
# illumos detaches idle instances during boot; amdgpu's teardown is not safe
# to run then (on the Mac Pro it switches the machine off).
file usr/src/uts/intel/io/amdgpu/amdgpu.conf path=kernel/drv/amdgpu.conf owner=root group=sys mode=0644 preserve=true reboot-needed=true
# /etc/system.d: runtime PM and ASPM off, for every GPU (the settings are
# per module); with them in the package, binding needs nothing by hand.
dir  path=etc/system.d owner=root group=sys mode=0755
file usr/src/uts/intel/io/amdgpu/amdgpu.system path=etc/system.d/driver:graphics:amdgpu owner=root group=sys mode=0644 preserve=true reboot-needed=true
# As i915n: the DRM minors are 0666, the console minor gfx0 0600.
# devlink.tab's name= is the device node's name (devfsadm.c, di_node_name()),
# which is "display" for a VGA-class GPU, not the driver's: name=amdgpu would
# never match. type=ddi_display:drm keeps it to DRM minor nodes.
driver name=amdgpu alias=pciex1002,67ef perms="* 0666 root sys" \
    perms="gfx* 0600 root sys" \
    devlink=type=ddi_display:drm;name=display\tdri/\M0
depend fmri=pkg:/driver/graphics/drm-core@0.0.2.12 type=require
depend fmri=pkg:/driver/graphics/linuxkpi@0.0.2.12 type=require
depend fmri=pkg:/driver/graphics/drm-helpers@0.0.2.12 type=require
depend fmri=pkg:/driver/graphics/drm-kms@0.0.2.12 type=require
depend fmri=pkg:/driver/graphics/drmadm@0.0.2.12 type=require
depend fmri=pkg:/driver/graphics/drm-core@0.0.2.12 type=incorporate
depend fmri=pkg:/driver/graphics/linuxkpi@0.0.2.12 type=incorporate
depend fmri=pkg:/driver/graphics/drm-kms@0.0.2.12 type=incorporate
license LICENSE.amdgpu license=MIT-amdgpu

# Unmodified AMD firmware (Tahiti); a separate licence from the driver.
dir path=kernel/firmware owner=root group=sys mode=0755
dir path=kernel/firmware/amdgpu owner=root group=sys mode=0755
file usr/src/data/firmware/amdgpu/tahiti_ce.bin path=kernel/firmware/amdgpu/tahiti_ce.bin owner=root group=sys mode=0444 reboot-needed=true
file usr/src/data/firmware/amdgpu/tahiti_mc.bin path=kernel/firmware/amdgpu/tahiti_mc.bin owner=root group=sys mode=0444 reboot-needed=true
file usr/src/data/firmware/amdgpu/tahiti_me.bin path=kernel/firmware/amdgpu/tahiti_me.bin owner=root group=sys mode=0444 reboot-needed=true
file usr/src/data/firmware/amdgpu/tahiti_pfp.bin path=kernel/firmware/amdgpu/tahiti_pfp.bin owner=root group=sys mode=0444 reboot-needed=true
file usr/src/data/firmware/amdgpu/tahiti_rlc.bin path=kernel/firmware/amdgpu/tahiti_rlc.bin owner=root group=sys mode=0444 reboot-needed=true
file usr/src/data/firmware/amdgpu/tahiti_smc.bin path=kernel/firmware/amdgpu/tahiti_smc.bin owner=root group=sys mode=0444 reboot-needed=true
file usr/src/data/firmware/amdgpu/tahiti_uvd.bin path=kernel/firmware/amdgpu/tahiti_uvd.bin owner=root group=sys mode=0444 reboot-needed=true
file usr/src/data/firmware/amdgpu/vce_1_0_0.bin path=kernel/firmware/amdgpu/vce_1_0_0.bin owner=root group=sys mode=0444 reboot-needed=true
license usr/src/data/firmware/LICENSE.amdgpu license=AMD-firmware
