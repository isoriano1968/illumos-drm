#
# IPS manifest of misc/drm_helpers (usr/src/uts/common/io/drm_helpers/), the Linux DRM helper code
# that C drivers on the illumos-drm facade link against with
# -N misc/drm_helpers: today drm_mm, Linux v7.2's range allocator, and
# drm_cache's CPU cache write-back (drm_clflush_virt_range(),
# drm_clflush_sg()), both carried unmodified (MIT), on misc/linuxkpi.
# Publish from a directory holding the module built by usr/src/uts/common/io/drm_helpers/build.sh as
# kernel/misc/amd64/drm_helpers, with this repository as the second
# directory for LICENSE, the carried files' notices (usr/src/uts/common/io/drm_helpers/drm_mm/LICENSE,
# usr/src/uts/common/io/drm_helpers/drm_cache/LICENSE) and the illumos-drm MIT notice of the
# reimplemented Linux interfaces (include/drm/LICENSE):
#
#   usr/src/uts/common/io/drm_helpers/build.sh            # $OUT/drm_helpers
#   cp $OUT/drm_helpers <proto>/kernel/misc/amd64/drm_helpers
#   pkgsend publish -s <repo> -d <proto> -d . usr/src/pkg/manifests/drm-helpers.p5m
#
# The module has no state, no device nodes and no driver action; it links
# against misc/linuxkpi (-N), which links against misc/drm_core, so it
# belongs to the illumos-drm stack. The kernel loads it with the first
# module that depends on it and keeps it while one does. Its exported names (drm_mm_init, ...)
# are also exported by gfx-drm's legacy misc/drm; krtld binds each module to
# the provider among its own dependencies, so the two stacks' modules never
# resolve against each other. The test driver drm_helpers_test is not
# packaged (usr/src/test/drm-tests/run-r5e-test.sh installs and removes it).
#
set name=pkg.fmri value=pkg://illumos-drm/driver/graphics/drm-helpers@0.0.2.1,5.11-2026.0.0.0
set name=pkg.summary value="Linux DRM helpers carried for C DRM drivers (misc/drm_helpers)"
set name=pkg.description value="misc/drm_helpers, the Linux DRM helper code that C drivers on the illumos-drm facade link against: drm_mm (the range allocator of GPU address spaces) and drm_cache (CPU cache write-back) from Linux v7.2, unmodified, on misc/linuxkpi, the MIT-licensed Linux compatibility layer."
set name=info.classification value=org.opensolaris.category.2008:Drivers/Display
set name=info.source-url value=https://code.aopc.cloud/illumos/illumos-drm
set name=variant.arch value=i386
set name=org.opensolaris.consolidation value=userland
dir  path=kernel owner=root group=sys mode=0755
dir  path=kernel/misc owner=root group=sys mode=0755
dir  path=kernel/misc/amd64 owner=root group=sys mode=0755
file path=kernel/misc/amd64/drm_helpers owner=root group=sys mode=0755 reboot-needed=true
depend fmri=pkg:/driver/graphics/linuxkpi@0.0.2.1 type=require
depend fmri=pkg:/driver/graphics/linuxkpi@0.0.2.1 type=incorporate
license LICENSE license=MPL-2.0
license usr/src/uts/common/io/drm_helpers/drm_mm/LICENSE license=MIT-drm_mm
license usr/src/uts/common/io/drm_helpers/drm_cache/LICENSE license=MIT-drm_cache
license usr/src/uts/common/drm/LICENSE license=MIT
