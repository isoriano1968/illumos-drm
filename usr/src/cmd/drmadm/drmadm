# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.
#
# drmadm: shows and selects which DRM stack binds the GPU, the legacy
# stack of gfx-drm (misc/drm and i915, package driver/graphics/drm) or
# the illumos-drm stack (misc/drm_core and its drivers). Both stacks can be
# installed together; their cores refuse to load while the other one is
# loaded, and the selection decides which one the system loads at boot.
# See drmadm(8) (tools/drmadm/drmadm.8).
#
#   drmadm [-R root] [status]
#   drmadm [-R root] select legacy|new
#   drmadm [-R root] perms
#
# Without a subcommand drmadm runs status, as ipadm(8) runs show-addr and
# dladm(8) runs show-link.
#
# A selection does three things and takes effect at the next boot:
#   1. writes /etc/system.d/driver:graphics:drmadm with exclude: lines for
#      the modules of the other stack, and records there the alias set it
#      manages (first, so that a failure loses no alias);
#   2. moves the Intel GPU PCI aliases between i915 (legacy) and i915n
#      (the name reserved for the illumos-drm Intel driver) with
#      update_drv -n, which edits /etc/driver_aliases without attaching
#      anything, and undoes both steps if that fails; without an
#      installed i915n the GPU is left unbound and falls back to the
#      generic VGA console driver; it also binds/unbinds the packaged virtio GPU aliases;
#   3. runs bootadm update-archive, since both files are read from the
#      boot archive.
# Loaded modules of either stack stay until the next boot (a console
# driver cannot be unloaded); it refuses while another drmadm holds its
# lock.
#
# "drmadm perms" keeps the device nodes of the new stack's drivers at their
# /etc/minor_perm permissions (0666 root sys as packaged). ttymon(8) runs
# di_devperm_logout() when it opens the console, at every boot and after
# every console logout, and login(1) runs di_devperm_login() at a console
# login: both apply the /etc/logindevperm rule "/dev/dri/*", which sets
# every /dev/dri node to 0600 and to root's (or the console user's) owner
# and group. A chown or chmod of a devfs node is kept in a shadow node on
# the root file system and wins over minor_perm from then on, also after
# a reboot, a module reload or rem_drv (without -C). drmadm perms
#   1. restricts each /etc/logindevperm rule for /dev/dri that names no
#      driver to the legacy stack's drivers (driver=i915,radeon), so the
#      console-user assignment stays as it was for them and leaves the new
#      stack's nodes alone;
#   2. resets every /dev/dri node of a new-stack driver whose owner, group
#      or mode differs from its /etc/minor_perm entry to that entry
#      (running system only), unless an /etc/logindevperm rule names the
#      driver.
# Only devices under the literal /dev/dri are rewritten; a rule that
# reaches /dev/dri through a pattern (/dev/*/*) is reported, not changed.
# The service svc:/system/graphics/drm-perms runs it at every boot before
# console-login and the display managers (packaging/drm-perms.xml). It
# also reconciles the generic Xorg configuration for new only after the
# selection has taken effect at boot; administrator files stay alone.

PATH=/usr/bin:/usr/sbin:/sbin
export PATH
LC_ALL=C
export LC_ALL

PROG=drmadm
ROOT=/

# The fragment's name follows system(5): the delivering package's name
# with '/' replaced by ':'. drmadm writes it; no package delivers it.
FRAGMENT=etc/system.d/driver:graphics:drmadm
LOCK=etc/system.d/.drmadm.lock
# Live-root selections only. /var/run must be tmpfs, cleared at each boot.
# Keep this absolute: -R must never write into an inactive root's /var/run.
BOOT_MARKER=/var/run/drmadm.pending

LEGACY_PKG=driver/graphics/drm
LEGACY_DRIVER=i915
NEW_DRIVER=i915n
NEW_PKG=driver/graphics/i915n
NEW_ALIASES=usr/share/drmadm/i915n.aliases
VIRTIO_DRIVER=virtio_gpu
VIRTIO_PKG=driver/graphics/virtio-gpu
VIRTIO_ALIASES=usr/share/drmadm/virtio-gpu.aliases
XORG_TEMPLATE=usr/share/drmadm/20-modesetting.conf
XORG_ACTIVE=etc/X11/xorg.conf.d/20-drmadm.conf
# A copy of exactly what we installed; changed/unowned files stay alone.
XORG_SAVED=etc/X11/.drmadm.conf
# class/name of each stack's kernel modules. Every driver of a stack
# depends on its core (misc/drm or misc/drm_core), so the cores alone
# decide whether a stack is loaded; the drivers are listed so that their
# excluded loads fail quietly at boot instead of on the missing core.
LEGACY_MODULES="misc/drm drv/i915 drv/radeon"
NEW_MODULES="misc/drm_core drv/i915n drv/virtio_gpu drv/cdrmnull drv/rdrmnull"
LEGACY_PKGS="driver/graphics/drm driver/graphics/agpgart"
NEW_PKGS="driver/graphics/drm-core driver/graphics/virtio-gpu driver/graphics/cdrmnull"
NEW_PKGS="$NEW_PKGS driver/graphics/linuxkpi driver/graphics/drm-helpers driver/graphics/drm-kms"
NEW_PKGS="$NEW_PKGS driver/graphics/i915n"
SHARED_PKGS="driver/graphics/drm-devlink driver/graphics/drmadm x11/library/libdrm"

LOGINDEVPERM=etc/logindevperm
# drv_names MODULES: the names of the drv/ modules of a list of class/name,
# the drivers of a stack, which create its /dev/dri nodes.
drv_names() {
	for m in $1; do
		case $m in
		drv/*) printf '%s ' "${m#drv/}" ;;
		esac
	done
}
LEGACY_DRIVERS=$(drv_names "$LEGACY_MODULES")
NEW_DRIVERS=$(drv_names "$NEW_MODULES")
# The marker of the rules drmadm perms restricted, in their comment.
LDP_MARK="drmadm(8): the next rule applies to the legacy DRM drivers only"

usage() {
	cat >&2 <<EOT
Usage: $PROG [-R root] [status]
       $PROG [-R root] select legacy|new
       $PROG [-R root] perms
EOT
	exit 2
}

die() {
	echo "$PROG: $*" >&2
	exit 1
}

# under PATH: PATH (relative to /) under the root. (Not "r", which is an
# alias of ksh93, the /bin/sh of illumos.)
under() {
	if [ "$ROOT" = / ]; then
		echo "/$1"
	else
		echo "${ROOT%/}/$1"
	fi
}

live() {
	[ "$ROOT" = / ]
}

pkgcmd() {
	if live; then
		pkg "$@"
	else
		pkg -R "$ROOT" "$@"
	fi
}

# names MODULES: the module names (no class) of a list of class/name.
names() {
	for m in $1; do
		echo "${m#*/}"
	done
}

# aliases_of DRIVER: the aliases bound to DRIVER in driver_aliases, one
# per line, without quotes, sorted.
aliases_of() {
	awk -v d="$1" '
	    /^[ \t]*#/ { next }
	    $1 == d { a = $2; gsub(/"/, "", a); if (a != "") print a }
	' "$(under etc/driver_aliases)" | sort -u
}

# driver_of ALIAS: the driver ALIAS is bound to, if any.
driver_of() {
	awk -v x="$1" '
	    /^[ \t]*#/ { next }
	    { a = $2; gsub(/"/, "", a); if (a == x) { print $1; exit } }
	' "$(under etc/driver_aliases)"
}

# installed DRIVER: whether DRIVER has a major number (add_drv was run).
installed() {
	awk -v d="$1" '$1 == d { f = 1 } END { exit !f }' "$(under etc/name_to_major)"
}

# manifest_aliases: the aliases of the i915 driver action of the installed
# driver/graphics/drm package, the set the legacy stack binds when
# installed (empty if the package is not installed).
manifest_aliases() {
	pkgcmd contents -m "$LEGACY_PKG" 2>/dev/null | awk -v d="$LEGACY_DRIVER" '
	    $1 == "driver" {
		ours = 0
		for (i = 2; i <= NF; i++)
			if ($i == "name=" d)
				ours = 1
		if (!ours)
			next
		for (i = 2; i <= NF; i++)
			if ($i ~ /^alias=/) {
				a = substr($i, 7)
				gsub(/"/, "", a)
				print a
			}
	    }' | sort -u
}

# New Intel IDs are independent of gfx-drm's older PCI table. Missing data
# is allowed for older i915n packages. Record this set separately so a
# later legacy selection never hands new-only aliases to the old driver,
# even after i915n is uninstalled and its data file disappears.
intel_aliases() {
	pkgcmd list -H "$NEW_PKG" >/dev/null 2>&1 || return 0
	f=$(under "$NEW_ALIASES")
	[ -f "$f" ] || return 0
	awk '
	    /^[ \t]*(#|$)/ { next }
	    NF != 1 || $1 !~ /^pci8086,[0-9a-f]+$/ { exit 1 }
	    { print }
	' "$f" || die "invalid alias data in $f"
}

# virtio_aliases: package data, never a binding in an IPS driver action.
# Require the installed package as well as its file and driver registration.
virtio_aliases() {
	pkgcmd list -H "$VIRTIO_PKG" >/dev/null 2>&1 || return 0
	f=$(under "$VIRTIO_ALIASES")
	[ -f "$f" ] || die "installed $VIRTIO_PKG has no $f"
	awk '
	    /^[ \t]*(#|$)/ { next }
	    NF != 1 || $1 !~ /^pci[0-9a-fA-F]+,[0-9a-fA-F]+$/ { exit 1 }
	    { print }
	' "$f" || die "invalid alias data in $f"
}

# recorded KEY: the values of "* drmadm-KEY: value" lines of the fragment.
recorded() {
	f=$(under "$FRAGMENT")
	[ -f "$f" ] || return 0
	sed -n "s/^\\* drmadm-$1: //p" "$f"
}

# loaded_modules: "id name" of every loaded module of either stack.
loaded_modules() {
	live || return 0
	all=$(names "$LEGACY_MODULES $NEW_MODULES" | tr '\n' ' ')
	modinfo | awk -v all="$all" '
	    BEGIN { n = split(all, m, " "); for (i = 1; i <= n; i++) want[m[i]] = 1 }
	    NR > 1 && ($6 in want) { print $1, $6 }'
}

# stack_of NAME: legacy or new.
stack_of() {
	for m in $(names "$LEGACY_MODULES"); do
		[ "$m" = "$1" ] && { echo legacy; return; }
	done
	echo new
}

# excludes: "file:line: value" for every exclude: line in /etc/system and
# the /etc/system.d fragments (dot files are not part of the boot
# configuration) that names a module of either stack.
excludes() {
	all=$(names "$LEGACY_MODULES $NEW_MODULES" | tr '\n' ' ')
	for f in "$(under etc/system)" "$(under etc/system.d)"/*; do
		[ -f "$f" ] || continue
		awk -v all="$all" -v f="$f" '
		    BEGIN { n = split(all, m, " "); for (i = 1; i <= n; i++) want[m[i]] = 1 }
		    /^[*#]/ { next }
		    {
			line = $0
			# The kernel knows "exclude" and "EXCLUDE" only.
			if (line !~ /^[ \t]*(exclude|EXCLUDE)[ \t]*:/)
				next
			sub(/^[ \t]*(exclude|EXCLUDE)[ \t]*:[ \t]*/, "", line)
			sub(/[ \t].*$/, "", line)
			name = line
			sub(/^.*\//, "", name)
			if (name in want)
				print f ":" NR ": " line
		    }' "$f"
	done
}

# words LIST: LIST (whitespace separated) as one space-separated line.
# Aliases and module names contain no glob characters.
words() {
	# shellcheck disable=SC2086 # splitting is the point
	echo $1
}

# count LIST: the number of words in LIST.
count() {
	# shellcheck disable=SC2086 # splitting is the point
	set -- $1
	echo $#
}

# minus A B: the words of A that are not in B, one per line.
minus() {
	for a in $1; do
		found=no
		for b in $2; do
			[ "$a" = "$b" ] && { found=yes; break; }
		done
		[ $found = no ] && echo "$a"
	done
}

# quoted LIST: update_drv's -i argument, "a" "b" ...
quoted() {
	q=
	for a in $1; do
		q="$q \"$a\""
	done
	echo "${q# }"
}

# udrv ARGS: update_drv -n (files only) on the root.
udrv() {
	if live; then
		update_drv -n "$@"
	else
		update_drv -n -b "$ROOT" "$@"
	fi
}

# show LIST: LIST indented, folded to lines of about 72 columns.
show() {
	words "$1" | fold -s -w 72 | sed 's/^/    /'
}

# rollback MESSAGE: undoes a select that failed while moving aliases: gives
# the removed aliases back to $from, takes the added ones from $to,
# restores the previous fragment and exits.
rollback() {
	echo "$PROG: $1; undoing the selection" >&2
	rm -f "$tmp"
	for a in $(minus "$(aliases_of "$VIRTIO_DRIVER")" "$bound_virtio"); do
		udrv -d -i "$a" "$VIRTIO_DRIVER" >/dev/null 2>&1
	done
	back=$(minus "$bound_virtio" "$(aliases_of "$VIRTIO_DRIVER")")
	[ -n "$back" ] && udrv -a -i "$(quoted "$back")" "$VIRTIO_DRIVER" >/dev/null 2>&1
	vleft=$(minus "$bound_virtio" "$(aliases_of "$VIRTIO_DRIVER")")
	vextra=$(minus "$(aliases_of "$VIRTIO_DRIVER")" "$bound_virtio")
	for a in $(minus "$(aliases_of "$to")" "$bound_to"); do
		udrv -d -i "$a" "$to" >/dev/null 2>&1
	done
	back=$(minus "$bound_from" "$(aliases_of "$from")")
	[ -n "$back" ] && udrv -a -i "$(quoted "$back")" "$from" >/dev/null 2>&1
	left=$(minus "$bound_from" "$(aliases_of "$from")")
	extra=$(minus "$(aliases_of "$to")" "$bound_to")
	if [ -n "$left$extra$vleft$vextra" ]; then
		# The new fragment stays: it records every alias drmadm manages,
		# these included, and the next select gives them to a driver.
		rm -f "$prev"
		echo "$PROG: alias rollback incomplete: $from missing $(words "$left"), $to extra $(words "$extra"); $VIRTIO_DRIVER missing $(words "$vleft"), extra $(words "$vextra")" >&2
		echo "$PROG: $frag (the new selection, not yet in the boot archive) records them; run drmadm select again" >&2
	elif [ -f "$prev" ]; then
		mv -f "$prev" "$frag"
		echo "$PROG: the aliases and $frag are as before" >&2
	else
		rm -f "$frag"
		echo "$PROG: the aliases are as before; $frag is removed again" >&2
	fi
	if [ -z "$left$extra$vleft$vextra" ] && [ "$marker_added" = yes ]; then
		rm -f "$BOOT_MARKER" || echo "$PROG: cannot remove $BOOT_MARKER after rollback" >&2
	fi
	if [ "$archiving" = yes ]; then
		if live; then
			bootadm update-archive
		else
			bootadm update-archive -R "$ROOT"
		fi || echo "$PROG: could not restore the boot archive; run bootadm update-archive before booting" >&2
	fi
	exit 1
}

# selection_pending: a changed selection made during this running boot.
selection_pending() {
	live && { [ -e "$BOOT_MARKER" ] || [ -h "$BOOT_MARKER" ]; }
}

# selected_at_boot: timestamps in older fragments are informational only.
selected_at_boot() {
	live || return 1
	[ "$(recorded selected)" = new ] || return 1
	! selection_pending
}

# Mark before replacing the fragment. Refuse persistent markers, which could
# survive reboot and indefinitely defer Xorg reconciliation. df -n reports
# the type of the filesystem actually containing the directory.
mark_selection() {
	live || return 0
	fs=$(df -n "${BOOT_MARKER%/*}" 2>/dev/null) &&
	    [ "$(printf '%s\n' "$fs" | awk '{ print $NF }')" = tmpfs ] ||
	    rollback "${BOOT_MARKER%/*} must be on tmpfs for a live selection"
	selection_pending && return 0
	marker_added=yes
	(set -C; : > "$BOOT_MARKER") || rollback "cannot create $BOOT_MARKER"
}

# reconcile_xorg: boot service (also on package refresh), under select's lock.
# Never follow symlinks or replace/remove an administrator's file. The saved
# copy survives template upgrades and proves which bytes drmadm installed.
reconcile_xorg() {
	live || { echo "Xorg configuration is reconciled when $ROOT boots."; return 0; }
	mkdir "$(under "$LOCK")" 2>/dev/null || die "another drmadm is running (lock $(under "$LOCK"))"
	trap unlock EXIT
	trap 'exit 1' HUP INT TERM
	active=$(under "$XORG_ACTIVE")
	saved=$(under "$XORG_SAVED")
	template=$(under "$XORG_TEMPLATE")
	if [ -e "$active" ] || [ -h "$active" ]; then
		if [ -h "$active" ] || [ -h "$saved" ] || [ ! -f "$saved" ] ||
		    ! cmp -s "$active" "$saved"; then
			echo "Left alone: $active was not written by drmadm or has been changed."
			return 0
		fi
	fi
	if selected_at_boot; then
		[ -f "$template" ] || die "no Xorg template $template"
		mkdir -p "${active%/*}" || die "cannot create ${active%/*}"
		if cmp -s "$active" "$template"; then
			echo "$active is unchanged (new stack since this boot)."
			return 0
		fi
		tmp="${saved}.$$"
		cp "$template" "$tmp" && chmod 644 "$tmp" &&
		    mv -f "$tmp" "$saved" || die "cannot save $template"
		tmp="${active}.$$"
		cp "$saved" "$tmp" && chmod 644 "$tmp" &&
		    mv -f "$tmp" "$active" || die "cannot install $active"
		echo "Installed $active (new stack since this boot)."
	else
		if [ -f "$active" ]; then
			rm -f "$active" || die "cannot remove $active"
			echo "Removed $active (new stack not selected since this boot)."
		fi
		rm -f "$saved" || die "cannot remove $saved"
	fi
}

# LDP_AWK: awk functions that read an /etc/logindevperm line as libdevinfo's
# logindevperm() does: the text from the first '#' is a comment; the fields
# (separated by blanks) are the console, the mode and a ':'-separated device
# list; a rule whose text before the comment contains "driver" applies only
# to the nodes of the drivers listed after its "driver=" (check_driver_match,
# which splits the list at commas and blanks). Each '/'-separated component
# of a device is an anchored extended regular expression, or "*".
# ldp_parse() sets body, comment, nt and t[1..nt] (the fields), nd and
# dev[1..nd] (the devices), kind[1..nd]: "dri" for a device under the
# literal /dev/dri, "maybe" for a pattern that can also reach /dev/dri
# nodes (/dev/*/*), "other" otherwise; and restricted (1 if the rule has a
# driver list) with drv[1..nl] (the drivers listed).
LDP_AWK='
function comp_matches(re, name) {
	if (re == "*")
		return 1
	if (re !~ /[][.*+?(){}|^$\\]/)
		return re == name
	return name ~ ("^(" re ")$")
}
function ldp_parse(line,  i, j, k, w, n, c, l) {
	body = line
	comment = ""
	if ((i = index(body, "#")) > 0) {
		comment = substr(body, i)
		body = substr(body, 1, i - 1)
	}
	n = split(body, w, /[ \t]+/)
	nt = 0
	for (j = 1; j <= n; j++)
		if (w[j] != "")
			t[++nt] = w[j]
	nd = 0
	if (nt >= 3)
		nd = split(t[3], dev, ":")
	for (j = 1; j <= nd; j++) {
		k = split(dev[j], c, "/")
		if (c[1] != "" || k < 4)
			kind[j] = "other"
		else if (c[2] == "dev" && c[3] == "dri")
			kind[j] = "dri"
		else if (comp_matches(c[2], "dev") && comp_matches(c[3], "dri"))
			kind[j] = "maybe"
		else
			kind[j] = "other"
	}
	restricted = 0
	nl = 0
	if ((i = index(body, "driver")) > 0) {
		restricted = 1
		l = substr(body, i)
		sub(/^[^=]*=?/, "", l)
		n = split(l, w, /[, \t]+/)
		for (j = 1; j <= n; j++)
			if (w[j] != "")
				drv[++nl] = w[j]
	}
}
'

# ldp_rules: one line "LINE STATE RULE" for every /etc/logindevperm rule
# that reaches /dev/dri nodes. STATE is "all" (a /dev/dri device and no
# driver list: every driver's nodes), "pattern" (no driver list, and a
# device pattern such as /dev/*/* that also reaches /dev/dri, which
# drmadm does not rewrite), "new" (a driver list naming a driver of the
# new stack) or "legacy" (a driver list naming none).
ldp_rules() {
	f=$(under "$LOGINDEVPERM")
	[ -f "$f" ] || return 0
	awk -v new="$NEW_DRIVERS" "$LDP_AWK"'
	    BEGIN { n = split(new, a, " "); for (i = 1; i <= n; i++) isnew[a[i]] = 1 }
	    {
		ldp_parse($0)
		dri = maybe = 0
		for (j = 1; j <= nd; j++) {
			if (kind[j] == "dri")
				dri = 1
			if (kind[j] == "maybe")
				maybe = 1
		}
		if (!dri && !maybe)
			next
		if (restricted) {
			state = "legacy"
			for (j = 1; j <= nl; j++)
				if (drv[j] in isnew)
					state = "new"
		} else
			state = dri ? "all" : "pattern"
		print NR, state, $0
	    }' "$f"
}

# ldp_admin_drivers: the new-stack drivers that an /etc/logindevperm rule
# for /dev/dri names in its driver list: the administrator gives their
# nodes to the console user, and drmadm leaves them alone.
ldp_admin_drivers() {
	f=$(under "$LOGINDEVPERM")
	[ -f "$f" ] || return 0
	awk -v new="$NEW_DRIVERS" "$LDP_AWK"'
	    BEGIN { n = split(new, a, " "); for (i = 1; i <= n; i++) isnew[a[i]] = 1 }
	    {
		ldp_parse($0)
		if (!restricted)
			next
		for (j = 1; j <= nd; j++)
			if (kind[j] != "other")
				for (k = 1; k <= nl; k++)
					if (drv[k] in isnew)
						print drv[k]
	    }' "$f" | sort -u
}

# ldp_restrict: gives every /etc/logindevperm rule with a /dev/dri device
# and no driver list the list of the legacy stack's drivers. The /dev/dri
# devices move to a rule of their own, after a comment line that says so
# (the rule's own comment, if it had only /dev/dri devices, goes on the
# line before); the other devices stay on the original line. libdevinfo
# reads lines of up to 255 bytes (fgets into 256), so a rule that would
# get longer is not rewritten, and drmadm fails. Rules with a driver list
# and pattern rules are left as written and reported. The file is
# replaced by rename(2): login(1) and ttymon(8) read the old or the new
# file, never a part. Two drmadm perms at once both write their own
# temporary file from the same input and rename it over the file; the
# result is the same either way, and a second run changes nothing.
ldp_restrict() {
	f=$(under "$LOGINDEVPERM")
	if [ ! -f "$f" ]; then
		echo "$f does not exist: no console-login rule to restrict."
		return 0
	fi
	if [ -z "$(ldp_rules | awk '$2 == "all"')" ]; then
		echo "$f: no /dev/dri rule applies to every driver."
		ldp_report
		return 0
	fi
	tmp=$(under "etc/.logindevperm.drmadm.$$")
	trap 'rm -f "$tmp"' EXIT
	trap 'rm -f "$tmp"; exit 1' HUP INT TERM
	cp -p "$f" "$tmp" || die "cannot copy $f to $tmp"
	drivers=$(words "$LEGACY_DRIVERS" | tr ' ' ',')
	awk -v drivers="$drivers" -v mark="$LDP_MARK" "$LDP_AWK"'
	    {
		ldp_parse($0)
		ndri = 0
		for (j = 1; j <= nd; j++)
			if (kind[j] == "dri")
				ndri++
		if (restricted || ndri == 0) {
			print
			next
		}
		rest = ""
		for (j = 4; j <= nt; j++)
			rest = rest "\t" t[j]
		dri = other = ""
		for (j = 1; j <= nd; j++)
			if (kind[j] == "dri")
				dri = dri (dri == "" ? "" : ":") dev[j]
			else
				other = other (other == "" ? "" : ":") dev[j]
		rule = t[1] "\t" t[2] "\t" dri rest "\tdriver=" drivers
		if (length(rule) > 254) {
			printf("line %d would become %d bytes, longer than libdevinfo reads (254)\n",
			    NR, length(rule)) > "/dev/stderr"
			bad = 1
		}
		if (other != "")
			print t[1] "\t" t[2] "\t" other rest (comment == "" ? "" : "\t" comment)
		else if (comment != "")
			print comment
		print "# " mark
		print rule
	    }
	    END { exit bad }' "$f" > "$tmp" || {
		rm -f "$tmp"
		die "$f is unchanged: restrict its /dev/dri rule to driver=$drivers by hand"
	}
	mv -f "$tmp" "$f" || { rm -f "$tmp"; die "cannot replace $f"; }
	trap - EXIT HUP INT TERM
	echo "Restricted the /dev/dri rules of $f to the drivers $drivers:"
	ldp_rules | sed 's/^/  line /'
	ldp_report
}

# ldp_report: reports the /etc/logindevperm rules that drmadm leaves as
# written although they reach the new stack's nodes.
ldp_report() {
	ldp_rules | while read -r n state rule; do
		case $state in
		new) echo "Left as written: $(under "$LOGINDEVPERM"):$n names a driver of the new stack, whose nodes drmadm leaves alone:" ;;
		pattern) echo "Warning: $(under "$LOGINDEVPERM"):$n reaches /dev/dri through a pattern and applies to every driver; restrict it by hand (driver=$(words "$LEGACY_DRIVERS" | tr ' ' ',')):" ;;
		*) continue ;;
		esac
		echo "  $rule"
	done
}

# dri_nodes: one line "LINK DRIVER MINOR MODE OWNER GROUP WANT" for every
# /dev/dri link of the running system whose driver is loaded: the node's
# driver, minor name, mode (octal), owner and group, and in WANT
# "MODE OWNER GROUP" of the /etc/minor_perm entry the kernel applies, or
# "-" if there is none. The driver comes from /etc/path_to_inst by the
# link's device path (for a pseudo device, which is not there, it is the
# node name), and a link is followed (stat) only if its driver is
# loaded: a lookup in /devices attaches a driver that is not, and loading
# a DRM driver would make drmadm select refuse, or load a core beside the
# other one's stack. The kernel's list of a driver's entries
# (add_minorperm()) is built in file order: a "*" entry replaces the
# earlier one, an entry whose pattern is already listed replaces it in
# place, any other is inserted at the head; dev_minorperm() takes the
# first entry of the list whose pattern matches, else the "*" entry. So of
# two different matching patterns the later wins.
dri_nodes() {
	loaded=" $(modinfo | awk 'NR > 1 { print $6 }' | tr '\n' ' ') "
	for l in /dev/dri/*; do
		[ -h "$l" ] || continue
		# shellcheck disable=SC2012 # the target of the link, as ls prints it
		node=$(ls -l "$l" 2>/dev/null | sed -n 's/^.* -> //p')
		# ../../devices/pci@0,0/pci1af4,1100@10:card0 -> /pci@0,0/pci1af4,1100@10
		path=$(echo "$node" | sed -n 's|^.*/devices\(/[^:]*\):.*$|\1|p')
		[ -n "$path" ] || continue
		# Every driver path_to_inst lists for the path: one path can
		# have several (i915 and i915n for one Intel GPU), in an order
		# that a rewrite of the file can change.
		cands=$(awk -v p="\"$path\"" '$1 == p { gsub(/"/, "", $3); print $3 }' /etc/path_to_inst | sort -u)
		if [ -z "$cands" ]; then
			# Not in path_to_inst (pseudo devices are not): the node
			# name, if it is a driver's (cdrmnull@0 of cdrmnull.conf).
			n=${path##*/}
			n=${n%%@*}
			installed "$n" && cands=$n
		fi
		d=""
		nd=0
		for c in $cands; do
			case $loaded in
			*" $c "*) d=$c; nd=$((nd + 1)) ;;
			esac
		done
		# No loaded driver: not looked up. Several: the node's driver is
		# not known without the lookup, so it is reported and skipped.
		if [ $nd -gt 1 ]; then
			echo "$PROG: $l: several loaded drivers have $path in /etc/path_to_inst ($(words "$cands")); skipped" >&2
			continue
		fi
		[ $nd -eq 1 ] || continue
		info=$(ls -lL "$l" 2>/dev/null) || continue
		echo "$l $d ${node##*:} $info"
	done | awk -v mperm=/etc/minor_perm '
	    function glob(p) {
		gsub(/[.+(){}^$|\\]/, "\\\\&", p)
		gsub(/\*/, ".*", p)
		gsub(/\?/, ".", p)
		return "^" p "$"
	    }
	    function octal(s,  i, v) {
		v = 0
		for (i = 1; i <= length(s); i++)
			v = v * 8 + substr(s, i, 1)
		return sprintf("%04o", v)
	    }
	    function bits(s,  i, v) {
		v = 0
		for (i = 2; i <= 10; i++)
			v = v * 2 + (substr(s, i, 1) != "-")
		return sprintf("%04o", v)
	    }
	    BEGIN {
		while ((getline line < mperm) > 0) {
			if (line ~ /^[ \t]*(#|$)/)
				continue
			split(line, a, /[ \t]+/)
			d = a[1]
			sub(/:.*/, "", d)
			m = substr(a[1], length(d) + 2)
			want = octal(a[2]) " " a[3] " " a[4]
			if (m == "*") {
				wild[d] = want
				continue
			}
			for (i = 1; i <= np[d]; i++)
				if (name[d, i] == m)
					break
			if (i <= np[d]) {
				val[d, i] = want
				continue
			}
			# Insert at the head: entry 1 is the head.
			for (i = ++np[d]; i > 1; i--) {
				name[d, i] = name[d, i - 1]
				pat[d, i] = pat[d, i - 1]
				val[d, i] = val[d, i - 1]
			}
			name[d, 1] = m
			pat[d, 1] = glob(m)
			val[d, 1] = want
		}
	    }
	    {
		# LINK DRIVER MINOR MODE NLINK OWNER GROUP MAJOR,[ ]MINOR ...
		d = $2
		want = "-"
		for (i = 1; i <= np[d]; i++)
			if ($3 ~ pat[d, i]) {
				want = val[d, i]
				break
			}
		if (want == "-" && (d in wild))
			want = wild[d]
		print $1, d, $3, bits($4), $6, $7, want
	    }'
}

# new_driver NAME: whether NAME is a driver of the new stack.
new_driver() {
	case " $NEW_DRIVERS " in
	*" $1 "*) return 0 ;;
	esac
	return 1
}

# repair_nodes: resets every /dev/dri node of a new-stack driver whose
# owner, group or mode differs from its /etc/minor_perm entry to that
# entry, except the nodes of drivers an /etc/logindevperm rule names.
# chown(2) and chmod(2) of a devfs node store the result in its shadow
# node, so the reset lasts, as the wrong values did. Two runs at once
# set the same values.
repair_nodes() {
	rc=0
	fixed=0
	nodes=$(dri_nodes)
	admin=" $(ldp_admin_drivers | tr '\n' ' ') "
	# A here-document, not a pipe: the loop runs in this shell and its
	# counters survive it.
	while read -r l d minor mode owner group wmode wowner wgroup; do
		[ -n "$l" ] || continue
		new_driver "$d" || continue
		case $admin in
		*" $d "*) continue ;;
		esac
		if [ "$wmode" = "-" ]; then
			echo "$l ($d $minor): no /etc/minor_perm entry, left at $mode $owner $group"
			continue
		fi
		[ "$mode $owner $group" = "$wmode $wowner $wgroup" ] && continue
		if chown "$wowner:$wgroup" "$l" && chmod "$wmode" "$l"; then
			echo "Reset $l ($d $minor) from $mode $owner $group to $wmode $wowner $wgroup (/etc/minor_perm)."
			fixed=$((fixed + 1))
		else
			echo "$PROG: cannot reset $l to $wmode $wowner $wgroup" >&2
			rc=1
		fi
	done <<EOT
$nodes
EOT
	[ "$admin" != "  " ] && echo "Left alone: the nodes of$admin(named by /etc/logindevperm)."
	[ $fixed -eq 0 ] && [ $rc -eq 0 ] && echo "The /dev/dri nodes of the new stack's drivers have their /etc/minor_perm permissions."
	return $rc
}

do_perms() {
	ldp_restrict
	if live; then
		repair_nodes || exit 1
	else
		echo "Node permissions are reset on the running system only (the service"
		echo "svc:/system/graphics/drm-perms does it when $ROOT boots)."
	fi
	reconcile_xorg
}

do_status() {
	frag=$(under "$FRAGMENT")
	sel=$(recorded selected)
	echo "Root: $ROOT"
	if [ -z "$sel" ]; then
		echo "Selected stack: none (no $frag; nothing is excluded by drmadm)"
	else
		when="since the last boot"
		if live; then
			if selection_pending; then
				when="from the next boot (selected after this boot)"
			fi
		else
			when="in that root"
		fi
		echo "Selected stack: $sel, $when"
	fi

	echo
	echo "Packages:"
	# shellcheck disable=SC2086 # lists of package names
	# pkg list -H prints NAME [(PUBLISHER)] VERSION IFO; the publisher only
	# when it is not the first-ranked one.
	list=$(pkgcmd list -H $LEGACY_PKGS $NEW_PKGS $SHARED_PKGS 2>/dev/null |
	    awk '{ if ($2 ~ /^\(/) print $1, $3, $2; else print $1, $2 }')
	for p in $LEGACY_PKGS $NEW_PKGS $SHARED_PKGS; do
		case " $LEGACY_PKGS " in
		*" $p "*) k=legacy ;;
		*) case " $NEW_PKGS " in
		   *" $p "*) k=new ;;
		   *) k=shared ;;
		   esac ;;
		esac
		v=$(echo "$list" | awk -v p="$p" '$1 == p { print $2, $3 }')
		printf '  %-7s %-30s %s\n' "$k" "$p" "${v:-not installed}"
	done

	echo
	echo "Loaded DRM modules:"
	if live; then
		lm=$(loaded_modules)
		if [ -z "$lm" ]; then
			echo "  none"
		else
			echo "$lm" | while read -r id name; do
				printf '  %-7s %-12s id %s\n' "$(stack_of "$name")" "$name" "$id"
			done
		fi
	else
		echo "  (not the running system)"
	fi

	echo
	echo "Intel GPU aliases ($(under etc/driver_aliases)):"
	man=$(manifest_aliases)
	for d in "$LEGACY_DRIVER" "$NEW_DRIVER"; do
		n=$(count "$(aliases_of "$d")")
		if installed "$d"; then
			s=""
		else
			s=" (driver not installed)"
		fi
		printf '  %-7s %s aliases%s\n' "$d" "$n" "$s"
	done
	idata=$(intel_aliases) || die "cannot read Intel alias data"
	all=$(words "$man $idata $(aliases_of "$LEGACY_DRIVER") $(aliases_of "$NEW_DRIVER") $(recorded alias)" |
	    tr ' ' '\n' | sort -u)
	unbound=0
	other=""
	for a in $all; do
		d=$(driver_of "$a")
		case "$d" in
		"") unbound=$((unbound + 1)) ;;
		"$LEGACY_DRIVER" | "$NEW_DRIVER") ;;
		*) other="$other $a($d)" ;;
		esac
	done
	printf '  %-7s %s of the %s aliases drmadm manages\n' unbound "$unbound" "$(count "$all")"
	[ -n "$other" ] && echo "  bound to other drivers:$other"
	[ -n "$man" ] && echo "  ($LEGACY_PKG declares $(count "$man") aliases for $LEGACY_DRIVER)"

	echo
	echo "Virtio GPU aliases ($(under etc/driver_aliases)):"
	vdata=$(virtio_aliases) || die "cannot read virtio alias data"
	va=$(words "$vdata $(aliases_of "$VIRTIO_DRIVER") $(recorded virtio-alias)" |
	    tr ' ' '\n' | sort -u)
	printf '  %-10s %s aliases\n' "$VIRTIO_DRIVER" "$(count "$(aliases_of "$VIRTIO_DRIVER")")"
	vu=0
	for a in $va; do
		d=$(driver_of "$a")
		case $d in
		"") vu=$((vu + 1)) ;;
		"$VIRTIO_DRIVER") ;;
		*) echo "  left alone: $a ($d)" ;;
		esac
	done
	printf '  %-10s %s of the %s aliases drmadm manages\n' unbound "$vu" "$(count "$va")"

	echo
	n=$(ls "$(under dev/dri)" 2>/dev/null | wc -l | tr -d ' ')
	echo "/dev/dri links: $n (after a switch, devfsadm -C removes those of the other stack)"

	echo
	echo "Device node permissions (see drmadm perms):"
	rules=$(ldp_rules)
	if [ -z "$rules" ]; then
		echo "  $(under "$LOGINDEVPERM"): no rule for /dev/dri"
	else
		echo "$rules" | while read -r n state rule; do
			case $state in
			all) v="applies to every driver: run drmadm perms" ;;
			pattern) v="reaches /dev/dri through a pattern, for every driver: restrict it by hand" ;;
			new) v="names a driver of the new stack, whose nodes drmadm leaves alone" ;;
			*) v="applies to legacy drivers only" ;;
			esac
			echo "  $(under "$LOGINDEVPERM"):$n $v:"
			echo "    $rule"
		done
	fi
	if live; then
		echo "  (the nodes of loaded drivers; drmadm does not look up the others,"
		echo "  which would load them)"
		dri_nodes | while read -r l d minor mode owner group wmode wowner wgroup; do
			w=""
			if [ "$wmode" = "-" ]; then
				w=" (no /etc/minor_perm entry)"
			elif [ "$mode $owner $group" != "$wmode $wowner $wgroup" ]; then
				w=" (/etc/minor_perm: $wmode $wowner $wgroup)"
			fi
			printf '  %-20s %-10s %s %s %s%s\n' "$l" "$d" "$mode" "$owner" "$group" "$w"
		done
	fi

	echo
	echo "Excludes of DRM modules (read at boot):"
	ex=$(excludes)
	if [ -z "$ex" ]; then
		echo "  none"
	else
		echo "$ex" | sed 's/^/  /'
	fi
	return 0
}

unlock() {
	rmdir "$(under "$LOCK")" 2>/dev/null
}

do_select() {
	target=$1
	case $target in
	legacy)
		to=$LEGACY_DRIVER from=$NEW_DRIVER
		other_modules=$NEW_MODULES ;;
	new)
		to=$NEW_DRIVER from=$LEGACY_DRIVER
		other_modules=$LEGACY_MODULES ;;
	*)
		usage ;;
	esac

	[ -d "$(under etc/system.d)" ] || die "$(under etc/system.d) does not exist (illumos before 2018 has no /etc/system.d)"
	[ -f "$(under etc/driver_aliases)" ] || die "$(under etc/driver_aliases) does not exist"

	if live; then
		# A selection only edits files read at the next boot
		# (update_drv -n attaches and detaches nothing; the core of the
		# other stack is excluded from the next boot on), so loaded
		# modules of either stack stay as they are until then. A display
		# driver that is the system console (i915n with display, the
		# legacy i915 with its gfx console) cannot be unloaded anyway.
		lm=$(loaded_modules)
		if [ -n "$lm" ]; then
			echo "$PROG: loaded DRM modules stay until the next boot:" >&2
			echo "$lm" | while read -r id name; do
				echo "  $(stack_of "$name") $name (id $id)" >&2
			done
		fi
	fi

	if ! mkdir "$(under "$LOCK")" 2>/dev/null; then
		die "another drmadm is running (lock $(under "$LOCK")); remove it if none is"
	fi
	trap unlock EXIT
	# From the fragment write to the end of the alias moves, a signal
	# undoes the selection; before and after, it only drops the lock.
	moving=no
	archiving=no
	marker_added=no
	trap 'if [ $moving = yes ]; then rollback "interrupted"; fi; exit 1' HUP INT TERM

	changed=0
	frag=$(under "$FRAGMENT")
	prev=$(under etc/system.d/.drmadm.prev)
	tmp=$(under "etc/system.d/.drmadm.$$")

	# What changes. The alias set drmadm manages: the aliases the legacy
	# package declares for i915, those bound to either Intel driver, and
	# those an earlier selection recorded.
	man=$(manifest_aliases)
	bound_to=$(aliases_of "$to")
	bound_from=$(aliases_of "$from")
	idata=$(intel_aliases) || die "cannot read Intel alias data"
	intel_all=$(words "$idata $(recorded i915n-alias)" | tr ' ' '\n' | sort -u)
	all=$(words "$man $intel_all $bound_to $bound_from $(recorded alias)" | tr ' ' '\n' | sort -u)
	if [ "$target" = legacy ]; then
		if [ -n "$man" ]; then
			want=$man
		else
			# Without a legacy manifest, never assume new IDs work there.
			want=$(minus "$all" "$intel_all")
		fi
	else
		want=$all
	fi
	conflict=""
	ok=""
	for a in $want; do
		d=$(driver_of "$a")
		case "$d" in
		"" | "$to" | "$from") ok="$ok $a" ;;
		*) conflict="$conflict $a($d)" ;;
		esac
	done
	add=$(minus "$ok" "$bound_to")
	if [ -n "$add" ] && ! installed "$to"; then
		unbound=$add
		add=""
	else
		unbound=""
	fi

	bound_virtio=$(aliases_of "$VIRTIO_DRIVER")
	vdata=$(virtio_aliases) || die "cannot read virtio alias data"
	virtio_all=$(words "$vdata $bound_virtio $(recorded virtio-alias)" |
	    tr ' ' '\n' | sort -u)
	virtio_add=""
	virtio_remove=""
	if [ "$target" = new ] && installed "$VIRTIO_DRIVER" &&
	    pkgcmd list -H "$VIRTIO_PKG" >/dev/null 2>&1; then
		for a in $virtio_all; do
			d=$(driver_of "$a")
			case $d in
			"") virtio_add="$virtio_add $a" ;;
			"$VIRTIO_DRIVER") ;;
			*) conflict="$conflict $a($d)" ;;
			esac
		done
	else
		virtio_remove=$bound_virtio
	fi

	# 1. The fragment, first: it records the alias set, so a failure in
	# the alias moves below loses no alias. Rewritten (with a new time)
	# when its content changes or aliases move; the previous one is kept
	# until the moves succeed.
	{
		echo "* /$FRAGMENT: written by drmadm(8); do not edit."
		echo "* The $target DRM stack is selected: the modules of the other stack"
		echo "* are excluded from loading. To change it, run drmadm select."
		echo "* To undo by hand, remove this file, run bootadm update-archive and"
		echo "* restore only the aliases declared by the installed legacy i915 package."
		echo "* drmadm-selected: $target"
		echo "* drmadm-time: $(date +%s)"
		for a in $all; do
			echo "* drmadm-alias: $a"
		done
		for a in $intel_all; do
			echo "* drmadm-i915n-alias: $a"
		done
		for a in $virtio_all; do
			echo "* drmadm-virtio-alias: $a"
		done
		for m in $other_modules; do
			echo "exclude: $m"
			echo "exclude: ${m#*/}"
		done
	} > "$tmp" || die "cannot write $tmp"
	chmod 644 "$tmp"
	rm -f "$prev"
	if [ -f "$frag" ] && [ -z "$bound_from$virtio_remove" ] && [ -z "$add$virtio_add" ] &&
	    [ "$(grep -v '^\* drmadm-time:' "$frag")" = "$(grep -v '^\* drmadm-time:' "$tmp")" ]; then
		rm -f "$tmp"
		echo "$frag is unchanged ($target)."
	else
		[ -f "$frag" ] && { cp -p "$frag" "$prev" || die "cannot save $frag"; }
		moving=yes
		mark_selection
		mv -f "$tmp" "$frag" || rollback "cannot replace $frag"
		echo "Wrote $frag: selects $target, excludes $(names "$other_modules" | tr '\n' ' ')"
		changed=1
	fi

	# 2. The Intel GPU aliases, with update_drv -n: the files only, for the
	# next boot. -d takes one alias at a time: with a list it matches
	# nothing and still exits 0, so the result is read back.
	if [ -n "$bound_from" ]; then
		echo "Removing $(count "$bound_from") aliases from $from (update_drv -n -d -i ALIAS $from):"
		show "$bound_from"
		for a in $bound_from; do
			udrv -d -i "$a" "$from" >/dev/null 2>&1
		done
		left=$(aliases_of "$from")
		[ -z "$left" ] || rollback "update_drv -d left $(count "$left") aliases on $from: $(words "$left")"
	fi
	if [ -n "$add" ]; then
		echo "Adding $(count "$add") aliases to $to (update_drv -n -a -i '\"ALIAS\" ...' $to):"
		show "$add"
		udrv -a -i "$(quoted "$add")" "$to" || rollback "update_drv -a failed"
		missing=$(minus "$add" "$(aliases_of "$to")")
		[ -z "$missing" ] || rollback "update_drv -a did not bind $(count "$missing") aliases to $to"
	fi
	for a in $virtio_remove; do
		echo "Removing $a from $VIRTIO_DRIVER (update_drv -n)."
		udrv -d -i "$a" "$VIRTIO_DRIVER" >/dev/null 2>&1
	done
	if [ -n "$virtio_remove" ]; then
		left=$(aliases_of "$VIRTIO_DRIVER")
		[ -z "$left" ] || rollback "update_drv -d left virtio aliases: $(words "$left")"
	fi
	if [ -n "$virtio_add" ]; then
		echo "Adding $(words "$virtio_add") to $VIRTIO_DRIVER (update_drv -n)."
		udrv -a -i "$(quoted "$virtio_add")" "$VIRTIO_DRIVER" || rollback "virtio update_drv -a failed"
		missing=$(minus "$virtio_add" "$(aliases_of "$VIRTIO_DRIVER")")
		[ -z "$missing" ] || rollback "update_drv -a did not bind virtio aliases"
	fi

	if [ -n "$unbound" ]; then
		echo "$to is not installed: these $(count "$unbound") Intel GPU aliases stay unbound, and"
		echo "an Intel GPU falls back to the generic VGA console driver (vgatext):"
		show "$unbound"
	fi
	[ -n "$conflict" ] && echo "Left alone, bound to other drivers:$conflict"
	# Excludes elsewhere that would keep the selected stack from loading.
	own=$(names "$other_modules" | tr '\n' ' ')
	excludes | grep -v "^$frag:" | while IFS= read -r line; do
		n=${line##*/}
		n=${n##*: }
		case " $own " in
		*" $n "*) ;;
		*) echo "Warning: $line excludes a module of the $target stack; drmadm does not edit it." ;;
		esac
	done

	# 3. The boot archive.
	if [ $changed = 1 ]; then
		archiving=yes
		if live; then
			echo "Updating the boot archive (bootadm update-archive)."
			bootadm update-archive || rollback "bootadm update-archive failed"
		else
			echo "Updating the boot archive (bootadm update-archive -R $ROOT)."
			bootadm update-archive -R "$ROOT" || rollback "bootadm update-archive -R $ROOT failed"
		fi
		echo "The $target stack is selected from the next boot. After that boot,"
		echo "devfsadm -C removes the /dev/dri links of the other stack's devices."
	else
		echo "Nothing changed: the $target stack was selected already."
	fi
	moving=no
	rm -f "$prev"
	return 0
}

while getopts R: opt; do
	case $opt in
	R) ROOT=$OPTARG ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
case $ROOT in
/*) ;;
*) die "-R needs an absolute path, not $ROOT" ;;
esac
[ -d "$ROOT" ] || die "root $ROOT is not a directory"

[ $# -gt 0 ] || set -- status

case "$1" in
status)
	[ $# -eq 1 ] || usage
	do_status ;;
select)
	[ $# -eq 2 ] || usage
	do_select "$2" ;;
perms)
	[ $# -eq 1 ] || usage
	do_perms ;;
*)
	usage ;;
esac
