* amdgpu (driver/graphics/amdgpu): the settings tested on Polaris 11
* (MacBook Pro 15-inch 2017). Power management (dpm) is on (the driver
* default, tested 2026-11-19: SMU7 powerplay up, 4K60 H.264 decode and
* playback, no errors). Runtime PM, ASPM and the HDMI/DP audio part stay
* off until they are tested on illumos.
set amdgpu:amdgpu_runtime_pm = 0
set amdgpu:amdgpu_aspm = 0
set amdgpu:amdgpu_audio = 0
