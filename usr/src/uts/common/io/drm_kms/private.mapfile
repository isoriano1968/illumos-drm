# Copyright 2026 The illumos-drm authors
#
# The kernel symbols misc/drm_kms uses that neither the gate's ddi.mapfile
# nor the mapfiles of its dependencies (drm_facade.mapfile,
# linuxkpi.mapfile, drm_helpers.mapfile) declare, for its link with
# -z defs (carried/drm_kms/build.sh). Declarations only (EXTERN): genunix
# provides them.
#
$mapfile_version 2

SYMBOL_SCOPE {
	global:
		ddi_log_sysevent		{ FLAGS = EXTERN };
		ddi_pathname		{ FLAGS = EXTERN };
		#
		# The kernel's C memory and string functions
		# (common/util/memstr.c, common/util/string.c), which the
		# carried Linux code calls directly; the DDI lists bcmp,
		# memcpy, memset and strlcpy but not these.
		#
		memcmp			{ FLAGS = EXTERN };
		memmove			{ FLAGS = EXTERN };
		strlcat			{ FLAGS = EXTERN };
		#
		# The module operations of a misc module (modlmisc), which
		# every misc module's linkage names (misc/linuxkpi lists it
		# in its private.d too).
		#
		mod_miscops		{ FLAGS = EXTERN };
		#
		# <sys/atomic.h>: inline on x86, kernel functions on sparcv9
		# (common/atomic), which ddi.mapfile does not list.
		#
		atomic_add_32		{ FLAGS = EXTERN };
		atomic_add_64		{ FLAGS = EXTERN };
		atomic_add_32_nv		{ FLAGS = EXTERN };
		atomic_add_64_nv		{ FLAGS = EXTERN };
		atomic_cas_32		{ FLAGS = EXTERN };
		atomic_cas_64		{ FLAGS = EXTERN };
		atomic_cas_ptr		{ FLAGS = EXTERN };
		atomic_inc_32		{ FLAGS = EXTERN };
		atomic_inc_64		{ FLAGS = EXTERN };
		atomic_inc_32_nv		{ FLAGS = EXTERN };
		atomic_inc_64_nv		{ FLAGS = EXTERN };
		atomic_dec_32		{ FLAGS = EXTERN };
		atomic_dec_64		{ FLAGS = EXTERN };
		atomic_dec_32_nv		{ FLAGS = EXTERN };
		atomic_dec_64_nv		{ FLAGS = EXTERN };
		atomic_swap_32		{ FLAGS = EXTERN };
		atomic_swap_64		{ FLAGS = EXTERN };
		atomic_swap_ptr		{ FLAGS = EXTERN };
		atomic_or_32		{ FLAGS = EXTERN };
		atomic_and_32		{ FLAGS = EXTERN };
		atomic_or_64		{ FLAGS = EXTERN };
		atomic_and_64		{ FLAGS = EXTERN };
};
