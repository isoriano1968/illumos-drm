#
# The symbols misc/drm_helpers uses that the gate's ddi.mapfile
# (usr/src/uts/common/mapfiles/ddi.mapfile) does not declare, for its link
# with -z defs (carried/build.sh). Declarations only (EXTERN): genunix
# provides them.
#
$mapfile_version 2

SYMBOL_SCOPE {
	global:
		#
		# The linkage of a miscellaneous module (modlmisc(9S)),
		# exported by genunix; the DDI lists only mod_driverops.
		#
		mod_miscops		{ FLAGS = EXTERN };
};
