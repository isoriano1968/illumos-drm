#
# The symbol scope of misc/drm_helpers, for its link with -B reduce: the
# module entry points and the carried helpers' exported functions (the
# names drm_helpers.mapfile declares for dependent modules) stay global;
# everything else (drm_mm_print(), drm_cache's other functions, static
# helpers) becomes local, so no other module can bind to it.
#
$mapfile_version 2

SYMBOL_SCOPE {
	global:
		_init;
		_fini;
		_info;
		__drm_mm_interval_first;
		drm_mm_init;
		drm_mm_insert_node_in_range;
		drm_mm_remove_node;
		drm_mm_reserve_node;
		drm_mm_scan_add_block;
		drm_mm_scan_color_evict;
		drm_mm_scan_init_with_range;
		drm_mm_scan_remove_block;
		drm_mm_takedown;
		drm_clflush_virt_range;
		drm_clflush_sg;
	local:
		*;
};
