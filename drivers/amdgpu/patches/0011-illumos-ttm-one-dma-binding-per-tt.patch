+#else
 	if (alloc->dma_addr) {
+#endif
 		r = ttm_pool_map(pool, order, p, &first_dma);
 		if (r)
 			return r;
@@ -853,6 +891,12 @@
 	if (r)
 		goto error_free_all;
 
